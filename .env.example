# Copy to .env. Nothing environment-specific is committed (D4). No credentials or model ids live in the repository.
# --- model provider (behind app/llm.py; change provider by configuration only) ---
LLM_PROVIDER=offline            # offline (deterministic, no network) | openai_compat (any OpenAI-compatible endpoint, incl. the stub)
LLM_BASE_URL=                   # e.g. https://<provider>/v1   or  http://llm-stub:9000/v1 for load tests
LLM_API_KEY=                    # injected at runtime, never committed
LLM_MODEL=                      # model identifier injected at runtime
LLM_PRICE_PROMPT_PER_1K=0.0     # USD per 1k prompt tokens (set from your provider's price list to get real cost reporting)
LLM_PRICE_COMPLETION_PER_1K=0.0
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=2
BREAKER_FAILS=3
BREAKER_RESET_S=20
# --- agent bounds ---
MAX_STEPS=10                    # per attempt
MAX_TOOL_CALLS=8                # per attempt
MAX_RUN_SECONDS=60
MAX_VERIFY_RETRIES=2
AGENT_MODE=agentic              # agentic | single_pass (evaluation baseline)
PROMPT_VERSION=draft_v2
# --- platform ---
QUEUE_BACKEND=redis             # memory (single process, local dev) | redis (compose)
REDIS_URL=redis://redis:6379/0
VERIFIER_URL=http://verifier:8100
WORKER_THREADS=8
CACHE_RUNS=1
CACHE_TTL_S=300
RATE_LIMIT_PER_MIN=30
DEMO_MODE=1                     # enables fault-injection knobs used only in the demonstration; set 0 for anything real
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
STUB_DELAY_MS=800
GRAFANA_ADMIN_PASSWORD=change-me
